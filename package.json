{
  "name": "awesomic-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,storybook -c cyan,magenta \"next dev\" \"npm run storybook\"",
    "dev:next": "next dev",
    "build": "npm run build-storybook && rm -rf public/storybook && cp -R storybook-static public/storybook && next build",
    "start": "next start",
    "deploy": "npm run build && next start -p 3011",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sass": "^1.77.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "latest",
    "prettier": "^3.8.1",
    "storybook": "^10.5.10",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "latest"
  }
}
